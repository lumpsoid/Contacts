<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dedupe_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/dedupe_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/dedupe_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:title="@string/find_and_merge_duplicates"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <RelativeLayout
        android:id="@+id/dedupe_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/dedupe_progress_holder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/dedupe_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/dedupe_progress_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_margin"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dedupe_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/dedupe_empty_holder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/dedupe_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/activity_margin"
                android:text="@string/dedupe_no_duplicates"
                android:textSize="@dimen/bigger_text_size" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dedupe_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/close" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/dedupe_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/activity_margin"
            android:visibility="gone">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/dedupe_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dedupe_merge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/merge" />

        </LinearLayout>

        <org.fossify.commons.views.MyRecyclerView
            android:id="@+id/dedupe_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentTop="true"
            android:layout_above="@id/dedupe_bottom_bar"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:visibility="gone"
            app:layoutManager="org.fossify.commons.views.MyLinearLayoutManager" />

        <include
            android:id="@+id/dedupe_result"
            layout="@layout/view_dedupe_result"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
